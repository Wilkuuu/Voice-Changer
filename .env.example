# Copy to .env and edit as needed. docker compose picks this up automatically.

# Host port mapped to Gradio (7862 inside container).
VC_PORT=7862

# Directory on the host that will be mounted as /data inside the container.
# Put your input audio + samples here. ref_preprocess writes sidecar caches
# (*.ref<hash>.wav/.json) next to source files, so this must be writable.
HOST_AUDIO=./data

# Optional: Anthropic API key for the translation tab.
ANTHROPIC_API_KEY=
